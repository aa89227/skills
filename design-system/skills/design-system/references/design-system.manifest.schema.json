{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-system.manifest.schema.json",
  "title": "Design System Package Manifest",
  "description": "Versioned catalog generated and shipped with a Design System release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "systemId",
    "displayName",
    "releaseVersion",
    "contractVersion",
    "hosts",
    "components"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "systemId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "contractVersion": { "type": "string", "minLength": 1 },
    "contractFingerprint": { "type": "string", "minLength": 1 },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["react", "blazor"] }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "react": { "$ref": "#/$defs/packageReference" },
        "blazor": { "$ref": "#/$defs/packageReference" },
        "styles": { "$ref": "#/$defs/packageReference" },
        "contracts": { "$ref": "#/$defs/packageReference" }
      },
      "minProperties": 1
    },
    "styles": { "$ref": "#/$defs/styles" },
    "conformance": { "$ref": "#/$defs/conformance" },
    "documentation": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" }
  },
  "$defs": {
    "packageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "entrypoint"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "themeEntrypoints": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hostApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "status", "contract"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["experimental", "stable", "deprecated", "removed"]
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "replacement": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "minLength": 1 },
        "hostApis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "react": { "$ref": "#/$defs/hostApi" },
            "blazor": { "$ref": "#/$defs/hostApi" }
          },
          "minProperties": 1
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "react": { "type": "string", "minLength": 1 },
            "blazor": { "type": "string", "minLength": 1 }
          },
          "minProperties": 1
        },
        "scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumReact": { "type": "string", "minLength": 1 },
        "minimumBlazor": { "type": "string", "minLength": 1 },
        "minimumContract": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioSource"],
      "properties": {
        "scenarioSource": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "minLength": 1 }
      }
    }
  }
}
