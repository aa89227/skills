{
  "schemaVersion": "1",
  "systemId": "company",
  "displayName": "Company Design System",
  "releaseVersion": "4.2.0",
  "contractVersion": "3",
  "contractFingerprint": "sha256:example-contract-fingerprint",
  "hosts": ["react", "blazor"],
  "packages": {
    "react": {
      "name": "@company/design-system-react",
      "version": "4.2.0"
    },
    "blazor": {
      "name": "Company.DesignSystem.Blazor",
      "version": "4.2.0"
    },
    "styles": {
      "name": "@company/design-system-css",
      "version": "4.2.0"
    },
    "contracts": {
      "name": "@company/design-system-contracts",
      "version": "4.2.0"
    }
  },
  "styles": {
    "package": "@company/design-system-css",
    "entrypoint": "dist/design-system.css",
    "themeEntrypoints": {
      "light": "dist/themes/light.css",
      "dark": "dist/themes/dark.css"
    }
  },
  "conformance": {
    "scenarioSource": "conformance/scenarios",
    "report": "conformance/reports/4.2.0"
  },
