  "components": [
    {
      "id": "button",
      "displayName": "Button",
      "status": "stable",
      "contract": "components/button/contract.json",
      "docs": "components/button",
      "hostApis": {
        "react": {
          "package": "@company/design-system-react",
          "export": "Button",
          "usage": "examples/button.react.tsx"
        },
        "blazor": {
          "package": "Company.DesignSystem.Blazor",
          "type": "Button",
          "usage": "examples/Button.razor"
        }
      },
      "examples": {
        "react": "examples/button.react.tsx",
        "blazor": "examples/Button.razor"
      }
    },
    {
      "id": "dialog",
      "displayName": "Dialog",
      "status": "stable",
      "aliases": ["Modal"],
      "contract": "components/dialog/contract.json",
      "docs": "components/dialog",
      "hostApis": {
        "react": {
          "package": "@company/design-system-react",
          "export": "Dialog",
          "usage": "examples/dialog.react.tsx"
        },
        "blazor": {
          "package": "Company.DesignSystem.Blazor",
          "type": "Dialog",
          "usage": "examples/Dialog.razor"
        }
      },
      "scenarios": [
        "dialog.open.escape",
        "dialog.open.overlay-dismiss",
        "dialog.open.focus-entry",
        "dialog.open.focus-containment",
        "dialog.close.focus-restoration"
      ],
      "examples": {
        "react": "examples/dialog.react.tsx",
        "blazor": "examples/Dialog.razor"
      }
    }
  ],
  "compatibility": {
    "minimumReact": "4.0.0",
    "minimumBlazor": "4.0.0",
    "minimumContract": "3"
  }
