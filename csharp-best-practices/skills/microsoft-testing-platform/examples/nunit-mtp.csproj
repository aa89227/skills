<!--
  NUnit MTP setup. The Microsoft.NET.Test.Sdk reference can remain when VSTest-based IDE/CI
  compatibility is still required; the NUnit runner property enables the MTP path.
  Package IDs are intentionally versionless; resolve their latest compatible stable versions with
  the package CLI before using this example.
  See references/runner-and-migration.md#nunit.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
</Project>
