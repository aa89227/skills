<!--
  xUnit.net v3 with an explicit MTP v2 package variant.
  Package IDs are intentionally versionless; resolve the latest compatible stable versions with
  the package CLI before using this example.
  See references/runner-and-migration.md#xunitnet-v3 and the xUnit-specific filter section in
  references/cli-and-configuration.md#filter-tests-inside-a-module.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />

    <!-- Add these only while VSTest consumers still need compatibility. -->
    <!--
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    -->
  </ItemGroup>
</Project>
