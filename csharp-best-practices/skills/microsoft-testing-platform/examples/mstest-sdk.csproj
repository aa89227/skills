<!--
  Native .NET 10 MTP setup.
  See references/runner-and-migration.md#mstest.
  Resolve the latest stable SDK and extension versions with the package tooling; do not copy
  versions from this example.
-->
<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Optional extensions; remove any capability the project does not need. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
