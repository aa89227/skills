#!/usr/bin/env bash
set -euo pipefail
umask 077

# This is the reference shell engine for workflow:review. Package installation should expose it
# through the stable `workflow-review` command rather than calling a versioned plugin-cache path.

review_store_root="${WORKFLOW_REVIEW_ROOT:-/tmp/workflow-reviews}"
while [[ "$review_store_root" != / && "$review_store_root" == */ ]]; do
  review_store_root="${review_store_root%/}"
done
[[ -n "$review_store_root" ]] || review_store_root=/
readonly review_store_root
readonly command_name="workflow-review"
readonly default_timeout_seconds=900
readonly minimum_timeout_seconds=600
active_start_directory=''

die() {
  printf '%s: %s\n' "$command_name" "$*" >&2
  exit 1
}

cleanup_partial_start() {
  if [[ -n "$active_start_directory" && -d "$active_start_directory" && ! -L "$active_start_directory" ]] \
    && is_safe_run_directory_path "$active_start_directory"; then
    rm -rf -- "$active_start_directory"
  fi
}

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required for machine-readable output"
}

require_flock() {
  command -v flock >/dev/null 2>&1 || die "flock is required for concurrent review task coordination"
}

require_hash_tool() {
  if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then
    return 0
  fi
  die "sha256sum or shasum is required for review target invalidation"
}

hash_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{ print $1 }'
  else
    shasum -a 256 | awk '{ print $1 }'
  fi
}

validate_review_id() {
  local review_id="$1"
  [[ "$review_id" =~ ^review-[a-f0-9]{16,64}$ ]] || die "invalid review id: $review_id"
}

validate_rule_id() {
  local rule_id="$1"
  [[ "$rule_id" =~ ^[a-z][a-z0-9-]*$ ]] || die "invalid rule id: $rule_id"
}

validate_step_id() {
  local step_id="$1"
  [[ "$step_id" =~ ^[a-z][a-z0-9-]*$ ]] || die "invalid step id: $step_id"
}

validate_task_id() {
  local task_id="$1"
  [[ "$task_id" =~ ^task-[a-f0-9]{16,64}$ ]] || die "invalid task id: $task_id"
}

random_hex() {
  od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
}

random_review_id() {
  printf 'review-%s' "$(random_hex)"
}

random_task_id() {
  printf 'task-%s' "$(random_hex)"
}

read_value() {
  local property_name="$1"
  local properties_file="$2"
  sed -n "s/^${property_name}=//p" "$properties_file" | head -n 1
}

write_value() {
  local property_name="$1"
  local property_value="$2"
  local properties_file="$3"
  local temporary_file

  temporary_file="$(mktemp "${properties_file}.XXXXXX")"
  awk -v key="$property_name" -v value="$property_value" '
    BEGIN { updated = 0 }
    index($0, key "=") == 1 {
      print key "=" value
      updated = 1
      next
    }
    { print }
    END {
      if (!updated) print key "=" value
    }
  ' "$properties_file" > "$temporary_file"
  mv -- "$temporary_file" "$properties_file"
}

monotonic_milliseconds() {
  [[ -r /proc/uptime ]] || return 1
  awk '{ printf "%.0f\n", $1 * 1000 }' /proc/uptime
}

frontmatter_value() {
  local metadata_file="$1"
  local metadata_key="$2"

  awk -v key="$metadata_key" '
    NR == 1 && $0 == "---" { inside = 1; next }
    inside && $0 == "---" { exit }
    inside {
      prefix = key ":"
      if (index($0, prefix) == 1) {
        value = substr($0, length(prefix) + 1)
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        print value
        exit
      }
    }
  ' "$metadata_file"
}

trim_space() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

validate_step_list() {
  local value="$1"
  local field_name="$2"
  local allow_empty="${3:-false}"
  local raw_step_id
  local step_id
  local -a step_ids=()
  local -A seen_step_ids=()

  if [[ -z "$value" ]]; then
    [[ "$allow_empty" = true ]] || die "$field_name is missing"
    return 0
  fi

  IFS=',' read -r -a step_ids <<< "$value"
  for raw_step_id in "${step_ids[@]}"; do
    step_id="$(trim_space "$raw_step_id")"
    [[ -n "$step_id" ]] || die "$field_name contains an empty step id"
    validate_step_id "$step_id"
    [[ -z "${seen_step_ids[$step_id]+set}" ]] || die "$field_name contains a duplicate step id: $step_id"
    seen_step_ids[$step_id]=1
  done
}

csv_contains() {
  local value="$1"
  local requested_id="$2"
  local raw_id
  local id
  local -a ids=()

  [[ -n "$value" ]] || return 1
  IFS=',' read -r -a ids <<< "$value"
  for raw_id in "${ids[@]}"; do
    id="$(trim_space "$raw_id")"
    [[ "$id" = "$requested_id" ]] && return 0
  done
  return 1
}

validate_rule_file() {
  local rule_file="$1"
  local expected_rule_id="$2"
  local rule_id
  local rule_name
  local rule_type
  local enabled
  local required
  local steps
  local dynamic_parents

  [[ "$(sed -n '1p' "$rule_file")" = "---" ]] || die "rule is missing frontmatter: $rule_file"

  rule_type="$(frontmatter_value "$rule_file" type)"
  rule_id="$(frontmatter_value "$rule_file" id)"
  rule_name="$(frontmatter_value "$rule_file" name)"
  enabled="$(frontmatter_value "$rule_file" enabled)"
  required="$(frontmatter_value "$rule_file" required)"
  steps="$(frontmatter_value "$rule_file" steps)"
  dynamic_parents="$(frontmatter_value "$rule_file" dynamic_parents)"

  [[ "$rule_type" = "review-rule" ]] || die "rule type must be review-rule: $rule_file"
  [[ "$rule_id" = "$expected_rule_id" ]] || die "rule id does not match file name: $rule_file"
  [[ -n "$rule_name" ]] || die "rule name is missing: $rule_file"
  [[ "$enabled" = true || "$enabled" = false ]] || die "enabled must be true or false: $rule_file"
  [[ "$required" = true || "$required" = false ]] || die "required must be true or false: $rule_file"
  validate_rule_id "$rule_id"
  [[ "$rule_name" != *$'\t'* ]] || die "rule name may not contain tabs: $rule_file"
  validate_step_list "$steps" "steps"
  validate_step_list "$dynamic_parents" "dynamic_parents" true
  local raw_parent_id
  local parent_id
  local -a parent_ids=()
  IFS=',' read -r -a parent_ids <<< "$dynamic_parents"
  for raw_parent_id in "${parent_ids[@]}"; do
    [[ -n "$raw_parent_id" ]] || continue
    parent_id="$(trim_space "$raw_parent_id")"
    csv_contains "$steps" "$parent_id" \
      || die "dynamic_parents contains a step that is not in steps: $parent_id"
  done
}

ensure_store_root() {
  case "$review_store_root" in
    /tmp|/tmp/*) ;;
    *) die "review artifact root must be under /tmp: $review_store_root" ;;
  esac
  case "$review_store_root" in
    */../*|*/..|*/./*|*/.) die "review artifact root may not contain . or .. path segments: $review_store_root" ;;
  esac

  local existing_parent="$review_store_root"
  while [[ ! -e "$existing_parent" && ! -L "$existing_parent" ]]; do
    [[ "$existing_parent" != /tmp && "$existing_parent" != / ]] || break
    existing_parent="${existing_parent%/*}"
    [[ -n "$existing_parent" ]] || existing_parent=/
  done
  [[ -d "$existing_parent" ]] || die "review artifact root parent is not a directory: $existing_parent"

  local resolved_parent
  resolved_parent="$(cd -- "$existing_parent" && pwd -P)" \
    || die "unable to resolve review artifact root parent: $existing_parent"
  case "$resolved_parent" in
    /tmp|/tmp/*) ;;
    *) die "review artifact root parent resolves outside /tmp: $resolved_parent" ;;
  esac

  [[ ! -L "$review_store_root" ]] || die "review artifact root may not be a symlink: $review_store_root"
  mkdir -p -- "$review_store_root"
  [[ -d "$review_store_root" ]] || die "review artifact root is not a directory: $review_store_root"
  local resolved_store_root
  resolved_store_root="$(cd -- "$review_store_root" && pwd -P)"
  case "$resolved_store_root" in
    /tmp|/tmp/*) ;;
    *) die "review artifact root resolves outside /tmp: $resolved_store_root" ;;
  esac
}

is_safe_run_directory_path() {
  local candidate="$1"
  local expected_prefix="${review_store_root%/}/review-"
  local resolved_store_root
  local resolved_directory

  [[ -d "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$candidate" = "$expected_prefix"* ]] || return 1
  [[ ! -L "$review_store_root" ]] || return 1

  resolved_store_root="$(cd -- "$review_store_root" 2>/dev/null && pwd -P)" || return 1
  resolved_directory="$(cd -- "$candidate" 2>/dev/null && pwd -P)" || return 1
  case "$resolved_store_root" in
    /tmp|/tmp/*) ;;
    *) return 1 ;;
  esac
  case "$resolved_directory" in
    "$resolved_store_root"/*) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_project_root() {
  local requested_root="$1"
  cd -- "$requested_root" 2>/dev/null && pwd -P || die "project root does not exist: $requested_root"
}

run_directory() {
  local review_id="$1"
  validate_review_id "$review_id"
  local directory="${review_store_root}/${review_id}"
  [[ -d "$directory" ]] || die "review run not found: $review_id"
  [[ ! -L "$directory" ]] || die "review run may not be a symlink: $review_id"
  is_safe_run_directory_path "$directory" \
    || die "review run resolves outside the artifact root or /tmp: $review_id"
  printf '%s\n' "$directory"
}

run_property_file() {
  local run_directory_path="$1"
  printf '%s/run.env\n' "$run_directory_path"
}

wait_property_file() {
  local run_directory_path="$1"
  printf '%s/wait.env\n' "$run_directory_path"
}

rules_file() {
  local run_directory_path="$1"
  printf '%s/rules.tsv\n' "$run_directory_path"
}

rule_snapshot() {
  local run_directory_path="$1"
  local rule_id="$2"
  printf '%s/rules/%s.md\n' "$run_directory_path" "$rule_id"
}

rule_row() {
  local run_directory_path="$1"
  local requested_rule_id="$2"
  awk -F '\t' -v id="$requested_rule_id" '$1 == id { print; exit }' "$(rules_file "$run_directory_path")"
}

task_file_for_rule() {
  local run_directory_path="$1"
  local requested_rule_id="$2"
  local task_file
  local task_rule_id
  local task_directory

  [[ -d "$run_directory_path/tasks" ]] || return 0
  for task_directory in "$run_directory_path"/tasks/task-*; do
    [[ -d "$task_directory" ]] || continue
    task_file="$task_directory/task.env"
    [[ -f "$task_file" ]] || continue
    task_rule_id="$(read_value rule_id "$task_file")"
    if [[ "$task_rule_id" = "$requested_rule_id" ]]; then
      printf '%s\n' "$task_file"
      return 0
    fi
  done
}

task_file_for_id() {
  local run_directory_path="$1"
  local requested_task_id="$2"
  local task_file
  local task_id
  local task_directory

  [[ -d "$run_directory_path/tasks" ]] || return 0
  for task_directory in "$run_directory_path"/tasks/task-*; do
    [[ -d "$task_directory" ]] || continue
    task_file="$task_directory/task.env"
    [[ -f "$task_file" ]] || continue
    task_id="$(read_value task_id "$task_file")"
    if [[ "$task_id" = "$requested_task_id" ]]; then
      printf '%s\n' "$task_file"
      return 0
    fi
  done
}

task_steps_manifest() {
  local task_properties_file="$1"
  local task_directory
  task_directory="$(read_value task_dir "$task_properties_file")"
  printf '%s/steps.tsv\n' "$task_directory"
}

task_steps_directory() {
  local task_properties_file="$1"
  local task_directory
  task_directory="$(read_value task_dir "$task_properties_file")"
  printf '%s/steps\n' "$task_directory"
}

task_step_file() {
  local task_properties_file="$1"
  local requested_step_id="$2"
  validate_step_id "$requested_step_id"
  local task_steps_directory_path
  task_steps_directory_path="$(task_steps_directory "$task_properties_file")"
  local step_file="${task_steps_directory_path}/${requested_step_id}/step.env"
  [[ -f "$step_file" ]] || return 0
  printf '%s\n' "$step_file"
}

task_step_row() {
  local task_properties_file="$1"
  local requested_step_id="$2"
  awk -F '\t' -v id="$requested_step_id" '$1 == id { print; exit }' \
    "$(task_steps_manifest "$task_properties_file")"
}

step_is_successful() {
  local step_state="$1"
  [[ "$step_state" = completed ]]
}

step_json() {
  local step_properties_file="$1"
  local task_properties_file="$2"
  local step_id
  local parent_step_id
  local kind
  local state
  local order
  local reason
  local artifact_path

  step_id="$(read_value step_id "$step_properties_file")"
  parent_step_id="$(read_value parent_step_id "$step_properties_file")"
  kind="$(read_value kind "$step_properties_file")"
  state="$(read_value state "$step_properties_file")"
  order="$(read_value order "$step_properties_file")"
  reason="$(read_value reason "$step_properties_file")"
  artifact_path="$(read_value artifact_path "$step_properties_file")"

  jq -n --arg step_id "$step_id" --arg parent_step_id "$parent_step_id" \
    --arg kind "$kind" --arg state "$state" --arg order "$order" \
    --arg reason "$reason" --arg artifact_path "$artifact_path" \
    '{step_id: $step_id, parent_step_id: (if $parent_step_id == "" then null else $parent_step_id end), kind: $kind, state: $state, order: ($order | tonumber), reason: (if $reason == "" then null else $reason end), artifact_path: $artifact_path}'
}

task_steps_json() {
  local task_properties_file="$1"
  local step_file
  local steps_json='[]'
  local step_json_value

  while IFS=$'\t' read -r step_id parent_step_id kind order; do
    [[ -n "$step_id" ]] || continue
    step_file="$(task_step_file "$task_properties_file" "$step_id")"
    [[ -n "$step_file" ]] || die "step state file is missing: $step_id"
    step_json_value="$(step_json "$step_file" "$task_properties_file")"
    steps_json="$(jq -c --argjson step "$step_json_value" '. + [$step]' <<< "$steps_json")"
  done < "$(task_steps_manifest "$task_properties_file")"
  printf '%s\n' "$steps_json"
}

find_task_file() {
  local requested_task_id="$1"
  local review_directory_path
  local candidate_task_file
  local matching_run_count=0
  local matching_task_file=''

  validate_task_id "$requested_task_id"
  for review_directory_path in "$review_store_root"/review-*; do
    [[ -d "$review_directory_path" && ! -L "$review_directory_path" ]] || continue
    candidate_task_file="$(task_file_for_id "$review_directory_path" "$requested_task_id")"
    if [[ -n "$candidate_task_file" ]]; then
      matching_run_count=$((matching_run_count + 1))
      ((matching_run_count <= 1)) || die "task id is not unique: $requested_task_id"
      matching_task_file="$candidate_task_file"
    fi
  done
  [[ -n "$matching_task_file" ]] || die "task not found: $requested_task_id"
  printf '%s\n' "$matching_task_file"
}

initialize_task_steps() {
  local task_properties_file="$1"
  local rule_file="$2"
  local steps_value
  local dynamic_parents
  local raw_step_id
  local step_id
  local -a step_ids=()
  local step_order=0
  local task_directory
  local task_steps_directory_path
  local step_directory_path
  local step_file
  local artifact_path

  steps_value="$(frontmatter_value "$rule_file" steps)"
  dynamic_parents="$(frontmatter_value "$rule_file" dynamic_parents)"
  validate_step_list "$steps_value" "steps"
  validate_step_list "$dynamic_parents" "dynamic_parents" true

  task_directory="$(read_value task_dir "$task_properties_file")"
  task_steps_directory_path="$(task_steps_directory "$task_properties_file")"
  mkdir -- "$task_steps_directory_path"
  : > "$(task_steps_manifest "$task_properties_file")"

  IFS=',' read -r -a step_ids <<< "$steps_value"
  for raw_step_id in "${step_ids[@]}"; do
    step_id="$(trim_space "$raw_step_id")"
    step_order=$((step_order + 1))
    step_directory_path="${task_steps_directory_path}/${step_id}"
    step_file="${step_directory_path}/step.env"
    artifact_path="${step_directory_path}/step.md"
    mkdir -- "$step_directory_path"
    {
      printf 'step_id=%s\n' "$step_id"
      printf 'parent_step_id=\n'
      printf 'kind=required\n'
      printf 'state=pending\n'
      printf 'order=%s\n' "$step_order"
      printf 'reason=\n'
      printf 'artifact_path=%s\n' "$artifact_path"
    } > "$step_file"
    printf '%s\t\trequired\t%s\n' "$step_id" "$step_order" >> "$(task_steps_manifest "$task_properties_file")"
  done
  write_value dynamic_parents "$dynamic_parents" "$task_properties_file"
}

target_commit() {
  local project_root="$1"
  local head_commit
  head_commit="$(git -C "$project_root" rev-parse HEAD 2>/dev/null || true)"

  if [[ -n "$head_commit" ]]; then
    local fingerprint
    fingerprint="$({
      printf 'head=%s\n' "$head_commit"
      git -C "$project_root" diff --no-ext-diff --binary HEAD
      git -C "$project_root" ls-files --others --exclude-standard -z |
        while IFS= read -r -d '' relative_path; do
          local file_path="${project_root}/${relative_path}"
          printf 'untracked=%s\0' "$relative_path"
          if [[ -f "$file_path" ]]; then
            cksum "$file_path"
          elif [[ -L "$file_path" ]]; then
            printf 'symlink\n'
          else
            printf 'missing\n'
          fi
        done
    } | hash_stream)"
    printf 'git:%s:%s\n' "$head_commit" "$fingerprint"
  else
    local fingerprint
    local file_path
    local -a project_files=()
    shopt -s dotglob globstar nullglob
    project_files=("$project_root"/**/*)
    shopt -u dotglob globstar nullglob
    fingerprint="$({
      for file_path in "${project_files[@]}"; do
        [[ -f "$file_path" ]] || continue
        case "$file_path" in
          "$project_root/.git/"*) continue ;;
        esac
        printf 'file=%s\0' "$file_path"
        cksum "$file_path"
      done
    } | hash_stream)"
    printf 'files:%s\n' "$fingerprint"
  fi
}

start_run() {
  require_jq
  require_hash_tool
  ensure_store_root

  local project_root='.'
  local requested_rule_id
  local -a selected_rule_ids=()
  local -A selected_rule_seen=()

  while (($# > 0)); do
    case "$1" in
      --project-root)
        (($# >= 2)) || die "--project-root needs a value"
        project_root="$2"
        shift 2
        ;;
      --rule-id)
        (($# >= 2)) || die "--rule-id needs a value"
        validate_rule_id "$2"
        if [[ -z "${selected_rule_seen[$2]+set}" ]]; then
          selected_rule_ids+=("$2")
          selected_rule_seen[$2]=1
        fi
        shift 2
        ;;
      --)
        shift
        (($# == 0)) || die "unexpected argument after --: $1"
        ;;
      *)
        die "unknown start argument: $1"
        ;;
    esac
  done

  project_root="$(resolve_project_root "$project_root")"
  local rule_directory="${project_root}/.workflow/review-rules"
  [[ -d "$rule_directory" ]] || die "project review rules are not configured: $rule_directory"

  shopt -s nullglob
  local -a rule_files=("${rule_directory}"/*.md)
  shopt -u nullglob
  ((${#rule_files[@]} > 0)) || die "project review rules are empty: $rule_directory"

  local review_id
  local run_directory_path
  local rule_file
  local file_rule_id
  local file_rule_name
  local file_enabled
  local file_required
  local selected_count=0
  local -A selected_rule_found=()
  local -A available_rule_seen=()
  local -A available_rule_enabled=()
  local -A available_rule_required=()
  local -A available_rule_name=()
  local enabled_rule_count=0

  for rule_file in "${rule_files[@]}"; do
    file_rule_id="$(basename "$rule_file" .md)"
    validate_rule_file "$rule_file" "$file_rule_id"
    file_rule_name="$(frontmatter_value "$rule_file" name)"
    file_enabled="$(frontmatter_value "$rule_file" enabled)"
    file_required="$(frontmatter_value "$rule_file" required)"
    available_rule_seen[$file_rule_id]=1
    available_rule_enabled[$file_rule_id]="$file_enabled"
    available_rule_required[$file_rule_id]="$file_required"
    available_rule_name[$file_rule_id]="$file_rule_name"
    [[ "$file_enabled" = true ]] && enabled_rule_count=$((enabled_rule_count + 1))
  done

  if ((${#selected_rule_ids[@]} > 0)); then
    for requested_rule_id in "${selected_rule_ids[@]}"; do
      [[ -n "${available_rule_seen[$requested_rule_id]+set}" ]] \
        || die "selected rule was not found: $requested_rule_id"
      [[ "${available_rule_enabled[$requested_rule_id]}" = true ]] \
        || die "selected rule is disabled: $requested_rule_id"
    done
    for requested_rule_id in "${!available_rule_seen[@]}"; do
      if [[ "${available_rule_enabled[$requested_rule_id]}" = true &&
        "${available_rule_required[$requested_rule_id]}" = true ]]; then
        [[ -n "${selected_rule_seen[$requested_rule_id]+set}" ]] \
          || die "enabled required rule was not selected: $requested_rule_id"
      fi
    done
  else
    ((enabled_rule_count > 0)) || die "no enabled review rules were selected"
  fi

  review_id="$(random_review_id)"
  run_directory_path="${review_store_root}/${review_id}"
  while ! mkdir -- "$run_directory_path" 2>/dev/null; do
    review_id="$(random_review_id)"
    run_directory_path="${review_store_root}/${review_id}"
  done
  active_start_directory="$run_directory_path"
  trap cleanup_partial_start EXIT
  mkdir -- "${run_directory_path}/rules" "${run_directory_path}/tasks"
  : > "$(rules_file "$run_directory_path")"

  for rule_file in "${rule_files[@]}"; do
    file_rule_id="$(basename "$rule_file" .md)"
    file_rule_name="${available_rule_name[$file_rule_id]}"
    file_enabled="${available_rule_enabled[$file_rule_id]}"
    file_required="${available_rule_required[$file_rule_id]}"

    if ((${#selected_rule_ids[@]} > 0)); then
      [[ -n "${selected_rule_seen[$file_rule_id]+set}" ]] || continue
      selected_rule_found[$file_rule_id]=1
    else
      [[ "$file_enabled" = true ]] || continue
    fi
    selected_rule_found[$file_rule_id]=1

    cp -- "$rule_file" "$(rule_snapshot "$run_directory_path" "$file_rule_id")"
    printf '%s\t%s\t%s\n' "$file_rule_id" "$file_rule_name" "$file_required" >> "$(rules_file "$run_directory_path")"
    selected_count=$((selected_count + 1))
  done

  if ((${#selected_rule_ids[@]} > 0)); then
    for requested_rule_id in "${selected_rule_ids[@]}"; do
      [[ -n "${selected_rule_found[$requested_rule_id]+set}" ]] \
        || die "selected rule was not found: $requested_rule_id"
    done
  fi

  ((selected_count > 0)) || die "no enabled review rules were selected"

  local current_target
  current_target="$(target_commit "$project_root")"
  {
    printf 'review_id=%s\n' "$review_id"
    printf 'project_root=%s\n' "$project_root"
    printf 'target=%s\n' "$current_target"
    printf 'state=running\n'
  } > "$(run_property_file "$run_directory_path")"

  local rule_json
  rule_json="$({
    while IFS=$'\t' read -r file_rule_id file_rule_name file_required; do
      [[ -n "$file_rule_id" ]] || continue
      jq -n --arg id "$file_rule_id" --arg name "$file_rule_name" --argjson required "$file_required" \
        '{rule_id: $id, name: $name, required: $required, state: "pending"}'
    done < "$(rules_file "$run_directory_path")"
  } | jq -s '.')"

  jq -n --arg review_id "$review_id" --arg artifact_dir "$run_directory_path" \
    --arg project_root "$project_root" --arg target "$current_target" --argjson rules "$rule_json" \
    '{review_id: $review_id, artifact_dir: $artifact_dir, project_root: $project_root, target: $target, rules: $rules}'
  active_start_directory=''
  trap - EXIT
}

get_task() {
  require_jq
  require_flock
  ensure_store_root

  local review_id=''
  local requested_rule_id=''
  while (($# > 0)); do
    case "$1" in
      --review-id)
        (($# >= 2)) || die "--review-id needs a value"
        review_id="$2"
        shift 2
        ;;
      --rule-id)
        (($# >= 2)) || die "--rule-id needs a value"
        requested_rule_id="$2"
        shift 2
        ;;
      *)
        die "unknown get-task argument: $1"
        ;;
    esac
  done
  [[ -n "$review_id" && -n "$requested_rule_id" ]] || die "get-task requires --review-id and --rule-id"
  validate_review_id "$review_id"
  validate_rule_id "$requested_rule_id"

  local run_directory_path
  run_directory_path="$(run_directory "$review_id")"
  local selected_row
  selected_row="$(rule_row "$run_directory_path" "$requested_rule_id")"
  [[ -n "$selected_row" ]] || die "rule is not selected for this review: $requested_rule_id"

  local lock_file="${run_directory_path}/run.lock"
  local lock_fd
  exec {lock_fd}>"$lock_file"
  flock "$lock_fd"

  local run_state
  run_state="$(read_value state "$(run_property_file "$run_directory_path")")"
  [[ "$run_state" = running ]] || die "review run is not accepting new tasks: $review_id ($run_state)"

  local existing_task_file
  existing_task_file="$(task_file_for_rule "$run_directory_path" "$requested_rule_id")"
  if [[ -n "$existing_task_file" ]]; then
    local existing_task_id
    existing_task_id="$(read_value task_id "$existing_task_file")"
    flock -u "$lock_fd"
    exec {lock_fd}>&-
    die "rule already has a claimed task: $requested_rule_id (task id: $existing_task_id)"
  fi

  local task_id
  local task_directory
  task_id="$(random_task_id)"
  task_directory="${run_directory_path}/tasks/${task_id}"
  while ! mkdir -- "$task_directory" 2>/dev/null; do
    task_id="$(random_task_id)"
    task_directory="${run_directory_path}/tasks/${task_id}"
  done
  {
    printf 'task_id=%s\n' "$task_id"
    printf 'review_id=%s\n' "$review_id"
    printf 'rule_id=%s\n' "$requested_rule_id"
    printf 'state=running\n'
    printf 'active_step=\n'
    printf 'task_dir=%s\n' "$task_directory"
    printf 'report_path=%s/report.md\n' "$task_directory"
  } > "${task_directory}/task.env"
  initialize_task_steps "${task_directory}/task.env" "$(rule_snapshot "$run_directory_path" "$requested_rule_id")"

  flock -u "$lock_fd"
  exec {lock_fd}>&-
  emit_task "$run_directory_path" "${task_directory}/task.env" "$requested_rule_id"
}

emit_task() {
  local run_directory_path="$1"
  local task_properties_file="$2"
  local requested_rule_id="$3"
  local project_root
  local target
  local task_id
  local task_directory
  local report_path
  local rule_content
  local steps_json

  project_root="$(read_value project_root "$(run_property_file "$run_directory_path")")"
  target="$(read_value target "$(run_property_file "$run_directory_path")")"
  task_id="$(read_value task_id "$task_properties_file")"
  task_directory="$(read_value task_dir "$task_properties_file")"
  report_path="$(read_value report_path "$task_properties_file")"
  rule_content="$(jq -Rs . < "$(rule_snapshot "$run_directory_path" "$requested_rule_id")")"
  steps_json="$(task_steps_json "$task_properties_file")"

  jq -n --arg review_id "$(basename "$run_directory_path")" --arg task_id "$task_id" \
    --arg rule_id "$requested_rule_id" --arg project_root "$project_root" --arg target "$target" \
    --arg artifact_dir "$task_directory" --arg report_path "$report_path" --argjson rule "$rule_content" \
    --argjson steps "$steps_json" --arg current_step "$(read_value active_step "$task_properties_file")" \
    '{review_id: $review_id, task_id: $task_id, rule_id: $rule_id, project_root: $project_root, target: $target, artifact_dir: $artifact_dir, report_path: $report_path, current_step: (if $current_step == "" then null else $current_step end), steps: $steps, rule: $rule}'
}

ensure_step_can_start() {
  local task_properties_file="$1"
  local step_properties_file="$2"
  local requested_step_id
  local parent_step_id
  local step_state
  local active_step
  local row_step_id
  local row_parent_step_id
  local row_kind
  local row_order
  local prior_step_file

  requested_step_id="$(read_value step_id "$step_properties_file")"
  parent_step_id="$(read_value parent_step_id "$step_properties_file")"
  step_state="$(read_value state "$step_properties_file")"
  active_step="$(read_value active_step "$task_properties_file")"
  [[ "$step_state" = pending ]] || die "step is not pending: $requested_step_id ($step_state)"

  if [[ -z "$parent_step_id" ]]; then
    [[ -z "$active_step" ]] || die "another step is already active: $active_step"
    while IFS=$'\t' read -r row_step_id row_parent_step_id row_kind row_order; do
      [[ -n "$row_step_id" ]] || continue
      [[ -n "$row_parent_step_id" ]] && continue
      [[ "$row_step_id" = "$requested_step_id" ]] && break
      prior_step_file="$(task_step_file "$task_properties_file" "$row_step_id")"
      step_is_successful "$(read_value state "$prior_step_file")" \
        || die "previous top-level step is not complete: $row_step_id"
    done < "$(task_steps_manifest "$task_properties_file")"
  else
    [[ "$active_step" = "$parent_step_id" ]] || die "parent step is not the active step: $parent_step_id"
    local parent_step_file
    local parent_state
    parent_step_file="$(task_step_file "$task_properties_file" "$parent_step_id")"
    [[ -n "$parent_step_file" ]] || die "parent step does not exist: $parent_step_id"
    parent_state="$(read_value state "$parent_step_file")"
    [[ "$parent_state" = running ]] || die "parent step is not active: $parent_step_id ($parent_state)"

    while IFS=$'\t' read -r row_step_id row_parent_step_id row_kind row_order; do
      [[ -n "$row_step_id" ]] || continue
      [[ "$row_step_id" = "$requested_step_id" ]] && break
      [[ "$row_parent_step_id" = "$parent_step_id" ]] || continue
      prior_step_file="$(task_step_file "$task_properties_file" "$row_step_id")"
      step_is_successful "$(read_value state "$prior_step_file")" \
        || die "previous dynamic step is not complete: $row_step_id"
    done < "$(task_steps_manifest "$task_properties_file")"
  fi
}

start_step() {
  require_jq
  require_flock
  ensure_store_root

  local task_id=''
  local requested_step_id=''
  while (($# > 0)); do
    case "$1" in
      --task-id)
        (($# >= 2)) || die "--task-id needs a value"
        task_id="$2"
        shift 2
        ;;
      --step-id)
        (($# >= 2)) || die "--step-id needs a value"
        requested_step_id="$2"
        shift 2
        ;;
      *)
        die "unknown start-step argument: $1"
        ;;
    esac
  done
  [[ -n "$task_id" && -n "$requested_step_id" ]] || die "start-step requires --task-id and --step-id"
  validate_task_id "$task_id"
  validate_step_id "$requested_step_id"

  local task_properties_file
  task_properties_file="$(find_task_file "$task_id")"
  local review_directory_path
  review_directory_path="$(dirname "$(dirname "$(dirname "$task_properties_file")")")"
  local lock_fd
  exec {lock_fd}>"${review_directory_path}/run.lock"
  flock "$lock_fd"

  local run_state
  local task_state
  local step_properties_file
  run_state="$(read_value state "$(run_property_file "$review_directory_path")")"
  task_state="$(read_value state "$task_properties_file")"
  [[ "$run_state" = running ]] || die "review run is not accepting step updates: $run_state"
  [[ "$task_state" = running ]] || die "task is not accepting step updates: $task_id ($task_state)"
  step_properties_file="$(task_step_file "$task_properties_file" "$requested_step_id")"
  [[ -n "$step_properties_file" ]] || die "step not found: $requested_step_id"
  ensure_step_can_start "$task_properties_file" "$step_properties_file"

  write_value state running "$step_properties_file"
  write_value started_at "$(date +%s)" "$step_properties_file"
  write_value active_step "$requested_step_id" "$task_properties_file"
  local step_value
  step_value="$(step_json "$step_properties_file" "$task_properties_file")"

  flock -u "$lock_fd"
  exec {lock_fd}>&-
  jq -n --arg review_id "$(basename "$review_directory_path")" --arg task_id "$task_id" \
    --arg current_step "$requested_step_id" --argjson step "$step_value" \
    '{review_id: $review_id, task_id: $task_id, current_step: $current_step, step: $step}'
}

add_step() {
  require_jq
  require_flock
  ensure_store_root

  local task_id=''
  local parent_step_id=''
  local requested_step_id=''
  local reason=''
  while (($# > 0)); do
    case "$1" in
      --task-id)
        (($# >= 2)) || die "--task-id needs a value"
        task_id="$2"
        shift 2
        ;;
      --parent-step-id)
        (($# >= 2)) || die "--parent-step-id needs a value"
        parent_step_id="$2"
        shift 2
        ;;
      --step-id)
        (($# >= 2)) || die "--step-id needs a value"
        requested_step_id="$2"
        shift 2
        ;;
      --reason)
        (($# >= 2)) || die "--reason needs a value"
        reason="$2"
        shift 2
        ;;
      *)
        die "unknown add-step argument: $1"
        ;;
    esac
  done
  [[ -n "$task_id" && -n "$parent_step_id" && -n "$requested_step_id" && -n "$reason" ]] \
    || die "add-step requires --task-id, --parent-step-id, --step-id, and --reason"
  validate_task_id "$task_id"
  validate_step_id "$parent_step_id"
  validate_step_id "$requested_step_id"
  [[ "$reason" != *$'\n'* && "$reason" != *$'\t'* ]] || die "step reason may not contain newlines or tabs"

  local task_properties_file
  task_properties_file="$(find_task_file "$task_id")"
  local review_directory_path
  review_directory_path="$(dirname "$(dirname "$(dirname "$task_properties_file")")")"
  local lock_fd
  exec {lock_fd}>"${review_directory_path}/run.lock"
  flock "$lock_fd"

  local run_state
  local task_state
  local active_step
  local dynamic_parents
  local parent_properties_file
  local existing_step_file
  local sibling_count
  local next_order
  local task_steps_directory_path
  local step_directory_path
  local step_properties_file
  local artifact_path
  local row_step_id
  local row_parent_step_id
  local row_kind
  local row_order
  run_state="$(read_value state "$(run_property_file "$review_directory_path")")"
  task_state="$(read_value state "$task_properties_file")"
  active_step="$(read_value active_step "$task_properties_file")"
  dynamic_parents="$(read_value dynamic_parents "$task_properties_file")"
  [[ "$run_state" = running ]] || die "review run is not accepting step updates: $run_state"
  [[ "$task_state" = running ]] || die "task is not accepting step updates: $task_id ($task_state)"
  [[ "$active_step" = "$parent_step_id" ]] || die "parent step is not the active step: $parent_step_id"
  csv_contains "$dynamic_parents" "$parent_step_id" \
    || die "dynamic steps are not allowed under parent step: $parent_step_id"
  parent_properties_file="$(task_step_file "$task_properties_file" "$parent_step_id")"
  [[ -n "$parent_properties_file" ]] || die "parent step does not exist: $parent_step_id"
  [[ -z "$(read_value parent_step_id "$parent_properties_file")" ]] \
    || die "dynamic parent must be a top-level step: $parent_step_id"
  [[ "$(read_value state "$parent_properties_file")" = running ]] \
    || die "parent step is not running: $parent_step_id"
  existing_step_file="$(task_step_file "$task_properties_file" "$requested_step_id")"
  [[ -z "$existing_step_file" ]] || die "step id already exists: $requested_step_id"

  sibling_count=0
  while IFS=$'\t' read -r row_step_id row_parent_step_id row_kind row_order; do
    [[ "$row_parent_step_id" = "$parent_step_id" ]] || continue
    sibling_count=$((sibling_count + 1))
  done < "$(task_steps_manifest "$task_properties_file")"
  ((sibling_count < 32)) || die "dynamic step limit reached for parent: $parent_step_id"

  next_order="$(awk -F '\t' 'BEGIN { max = 0 } $4 + 0 > max { max = $4 + 0 } END { print max + 1 }' "$(task_steps_manifest "$task_properties_file")")"
  task_steps_directory_path="$(task_steps_directory "$task_properties_file")"
  step_directory_path="${task_steps_directory_path}/${requested_step_id}"
  step_properties_file="${step_directory_path}/step.env"
  artifact_path="${step_directory_path}/step.md"
  mkdir -- "$step_directory_path"
  {
    printf 'step_id=%s\n' "$requested_step_id"
    printf 'parent_step_id=%s\n' "$parent_step_id"
    printf 'kind=dynamic\n'
    printf 'state=pending\n'
    printf 'order=%s\n' "$next_order"
    printf 'reason=%s\n' "$reason"
    printf 'artifact_path=%s\n' "$artifact_path"
  } > "$step_properties_file"
  printf '%s\t%s\tdynamic\t%s\n' "$requested_step_id" "$parent_step_id" "$next_order" \
    >> "$(task_steps_manifest "$task_properties_file")"
  local step_value
  step_value="$(step_json "$step_properties_file" "$task_properties_file")"

  flock -u "$lock_fd"
  exec {lock_fd}>&-
  jq -n --arg review_id "$(basename "$review_directory_path")" --arg task_id "$task_id" \
    --arg parent_step_id "$parent_step_id" --argjson step "$step_value" \
    '{review_id: $review_id, task_id: $task_id, parent_step_id: $parent_step_id, step: $step}'
}

complete_step() {
  require_jq
  require_flock
  ensure_store_root

  local task_id=''
  local requested_step_id=''
  local requested_status='completed'
  local reason=''
  while (($# > 0)); do
    case "$1" in
      --task-id)
        (($# >= 2)) || die "--task-id needs a value"
        task_id="$2"
        shift 2
        ;;
      --step-id)
        (($# >= 2)) || die "--step-id needs a value"
        requested_step_id="$2"
        shift 2
        ;;
      --status)
        (($# >= 2)) || die "--status needs a value"
        requested_status="$2"
        shift 2
        ;;
      --reason)
        (($# >= 2)) || die "--reason needs a value"
        reason="$2"
        shift 2
        ;;
      *)
        die "unknown complete-step argument: $1"
        ;;
    esac
  done
  [[ -n "$task_id" && -n "$requested_step_id" ]] || die "complete-step requires --task-id and --step-id"
  validate_task_id "$task_id"
  validate_step_id "$requested_step_id"
  [[ "$requested_status" = completed || "$requested_status" = failed || "$requested_status" = blocked ]] \
    || die "step status must be completed, failed, or blocked"
  if [[ "$requested_status" != completed ]]; then
    [[ -n "$reason" ]] || die "--reason is required for a non-completed step"
  fi
  [[ "$reason" != *$'\n'* && "$reason" != *$'\t'* ]] || die "step reason may not contain newlines or tabs"

  local task_properties_file
  task_properties_file="$(find_task_file "$task_id")"
  local review_directory_path
  review_directory_path="$(dirname "$(dirname "$(dirname "$task_properties_file")")")"
  local lock_fd
  exec {lock_fd}>"${review_directory_path}/run.lock"
  flock "$lock_fd"

  local run_state
  local task_state
  local active_step
  local step_properties_file
  local step_state
  local row_step_id
  local row_parent_step_id
  local row_kind
  local row_order
  local child_properties_file
  local parent_step_id
  local parent_properties_file
  run_state="$(read_value state "$(run_property_file "$review_directory_path")")"
  task_state="$(read_value state "$task_properties_file")"
  active_step="$(read_value active_step "$task_properties_file")"
  [[ "$run_state" = running ]] || die "review run is not accepting step updates: $run_state"
  [[ "$task_state" = running ]] || die "task is not accepting step updates: $task_id ($task_state)"
  [[ "$active_step" = "$requested_step_id" ]] || die "step is not active: $requested_step_id"
  step_properties_file="$(task_step_file "$task_properties_file" "$requested_step_id")"
  [[ -n "$step_properties_file" ]] || die "step not found: $requested_step_id"
  step_state="$(read_value state "$step_properties_file")"
  [[ "$step_state" = running ]] || die "step is not running: $requested_step_id ($step_state)"
  parent_step_id="$(read_value parent_step_id "$step_properties_file")"

  if [[ "$requested_status" = completed ]]; then
    while IFS=$'\t' read -r row_step_id row_parent_step_id row_kind row_order; do
      [[ "$row_parent_step_id" = "$requested_step_id" ]] || continue
      child_properties_file="$(task_step_file "$task_properties_file" "$row_step_id")"
      step_is_successful "$(read_value state "$child_properties_file")" \
        || die "child step is not complete: $row_step_id"
    done < "$(task_steps_manifest "$task_properties_file")"
  fi

  write_value state "$requested_status" "$step_properties_file"
  write_value reason "$reason" "$step_properties_file"
  write_value completed_at "$(date +%s)" "$step_properties_file"
  if [[ "$requested_status" = completed && -n "$parent_step_id" ]]; then
    write_value active_step "$parent_step_id" "$task_properties_file"
  else
    write_value active_step '' "$task_properties_file"
  fi
  if [[ "$requested_status" != completed ]]; then
    if [[ -n "$parent_step_id" ]]; then
      parent_properties_file="$(task_step_file "$task_properties_file" "$parent_step_id")"
      write_value state "$requested_status" "$parent_properties_file"
      write_value reason "child step ${requested_step_id}: ${reason}" "$parent_properties_file"
    fi
  fi
  local step_value
  step_value="$(step_json "$step_properties_file" "$task_properties_file")"

  flock -u "$lock_fd"
  exec {lock_fd}>&-
  jq -n --arg review_id "$(basename "$review_directory_path")" --arg task_id "$task_id" \
    --arg status "$requested_status" --argjson step "$step_value" \
    '{review_id: $review_id, task_id: $task_id, status: $status, step: $step}'
}

submit_task() {
  require_jq
  require_flock
  ensure_store_root

  local task_id=''
  local requested_status='completed'
  while (($# > 0)); do
    case "$1" in
      --task-id)
        (($# >= 2)) || die "--task-id needs a value"
        task_id="$2"
        shift 2
        ;;
      --status)
        (($# >= 2)) || die "--status needs a value"
        requested_status="$2"
        shift 2
        ;;
      *)
        die "unknown submit argument: $1"
        ;;
    esac
  done
  [[ -n "$task_id" ]] || die "submit requires --task-id"
  validate_task_id "$task_id"
  [[ "$requested_status" = completed || "$requested_status" = failed || "$requested_status" = blocked ]] \
    || die "status must be completed, failed, or blocked"

  local review_directory_path
  local task_properties_file
  local task_directory
  local report_path
  task_properties_file="$(find_task_file "$task_id")"

  review_directory_path="$(dirname "$(dirname "$(dirname "$task_properties_file")")")"
  local lock_file="${review_directory_path}/run.lock"
  local lock_fd
  exec {lock_fd}>"$lock_file"
  flock "$lock_fd"

  local run_state
  run_state="$(read_value state "$(run_property_file "$review_directory_path")")"
  [[ "$run_state" = running ]] || die "review run is not accepting submissions: $run_state"
  local current_task_state
  local active_step
  local step_id
  local step_state
  local has_failure=false
  current_task_state="$(read_value state "$task_properties_file")"
  [[ "$current_task_state" = running ]] || die "task is already terminal: $task_id ($current_task_state)"

  task_directory="$(read_value task_dir "$task_properties_file")"
  report_path="$(read_value report_path "$task_properties_file")"
  active_step="$(read_value active_step "$task_properties_file")"
  [[ -z "$active_step" ]] || die "cannot submit while a step is active: $active_step"
  [[ -s "$report_path" ]] || die "task must contain a non-empty report: $report_path"

  while IFS=$'\t' read -r step_id parent_step_id kind order; do
    [[ -n "$step_id" ]] || continue
    step_state="$(read_value state "$(task_step_file "$task_properties_file" "$step_id")")"
    if [[ "$requested_status" = completed ]]; then
      [[ "$step_state" = completed ]] || die "completed task has an unfinished step: $step_id ($step_state)"
    else
      case "$step_state" in
        failed|blocked) has_failure=true ;;
        running) die "terminal task has an active step: $step_id" ;;
        pending) ;;
      esac
    fi
  done < "$(task_steps_manifest "$task_properties_file")"
  if [[ "$requested_status" != completed && "$has_failure" != true ]]; then
    die "failed or blocked task must contain a failed or blocked step"
  fi

  write_value state "$requested_status" "$task_properties_file"
  flock -u "$lock_fd"
  exec {lock_fd}>&-

  jq -n --arg review_id "$(basename "$review_directory_path")" --arg task_id "$task_id" \
    --arg state "$requested_status" --arg artifact_dir "$task_directory" --arg report_path "$report_path" \
    '{review_id: $review_id, task_id: $task_id, state: $state, artifact_dir: $artifact_dir, report_path: $report_path}'
}

status_json() {
  local run_directory_path="$1"
  local rule_id="$2"
  local rule_name="$3"
  local required="$4"
  local task_properties_file
  local task_id=''
  local state='pending'
  local report_path=''
  local current_step=''
  local steps_json='[]'

  task_properties_file="$(task_file_for_rule "$run_directory_path" "$rule_id")"
  if [[ -n "$task_properties_file" ]]; then
    task_id="$(read_value task_id "$task_properties_file")"
    state="$(read_value state "$task_properties_file")"
    report_path="$(read_value report_path "$task_properties_file")"
    current_step="$(read_value active_step "$task_properties_file")"
    steps_json="$(task_steps_json "$task_properties_file")"
  fi

  jq -n --arg id "$rule_id" --arg name "$rule_name" --argjson required "$required" \
    --arg state "$state" --arg task_id "$task_id" --arg report_path "$report_path" \
    --arg current_step "$current_step" --argjson steps "$steps_json" \
    '{rule_id: $id, name: $name, required: $required, state: $state, task_id: (if $task_id == "" then null else $task_id end), report_path: (if $report_path == "" then null else $report_path end), current_step: (if $current_step == "" then null else $current_step end), steps: $steps}'
}

review_status() {
  require_jq
  ensure_store_root

  local review_id=''
  while (($# > 0)); do
    case "$1" in
      --review-id)
        (($# >= 2)) || die "--review-id needs a value"
        review_id="$2"
        shift 2
        ;;
      *)
        die "unknown status argument: $1"
        ;;
    esac
  done
  [[ -n "$review_id" ]] || die "status requires --review-id"
  validate_review_id "$review_id"

  local run_directory_path
  run_directory_path="$(run_directory "$review_id")"
  local rule_id
  local rule_name
  local rule_required
  local status_line
  local status_lines
  status_lines="$(mktemp "${run_directory_path}/status.XXXXXX")"
  : > "$status_lines"
  while IFS=$'\t' read -r rule_id rule_name rule_required; do
    [[ -n "$rule_id" ]] || continue
    status_line="$(status_json "$run_directory_path" "$rule_id" "$rule_name" "$rule_required")"
    printf '%s\n' "$status_line" >> "$status_lines"
  done < "$(rules_file "$run_directory_path")"
  local rules_json
  rules_json="$(jq -s '.' "$status_lines")"
  rm -f -- "$status_lines"
  local wait_json
  wait_json="$(wait_diagnostics_json "$run_directory_path")"
  jq -n --arg review_id "$review_id" --arg artifact_dir "$run_directory_path" \
    --arg state "$(read_value state "$(run_property_file "$run_directory_path")")" \
    --argjson rules "$rules_json" --argjson wait "$wait_json" \
    '{review_id: $review_id, artifact_dir: $artifact_dir, state: $state, wait: $wait, rules: $rules}'
}

wait_diagnostics_json() {
  local run_directory_path="$1"
  local wait_file
  wait_file="$(wait_property_file "$run_directory_path")"
  [[ -f "$wait_file" ]] || {
    printf 'null\n'
    return 0
  }

  jq -n \
    --arg pid "$(read_value wait_pid "$wait_file")" \
    --arg timeout_seconds "$(read_value wait_timeout_seconds "$wait_file")" \
    --arg clock_source "$(read_value wait_clock_source "$wait_file")" \
    --arg started_at_epoch "$(read_value wait_started_at_epoch "$wait_file")" \
    --arg started_at_monotonic_ms "$(read_value wait_started_at_monotonic_ms "$wait_file")" \
    --arg last_observed_epoch "$(read_value wait_last_observed_epoch "$wait_file")" \
    --arg last_observed_monotonic_ms "$(read_value wait_last_observed_monotonic_ms "$wait_file")" \
    --arg ended_at_epoch "$(read_value wait_ended_at_epoch "$wait_file")" \
    --arg ended_at_monotonic_ms "$(read_value wait_ended_at_monotonic_ms "$wait_file")" \
    --arg elapsed_ms "$(read_value wait_elapsed_ms "$wait_file")" \
    --arg state "$(read_value wait_state "$wait_file")" \
    '{pid: ($pid | try tonumber catch null), timeout_seconds: ($timeout_seconds | try tonumber catch null), clock_source: $clock_source, started_at_epoch: ($started_at_epoch | try tonumber catch null), started_at_monotonic_ms: ($started_at_monotonic_ms | try tonumber catch null), last_observed_epoch: ($last_observed_epoch | try tonumber catch null), last_observed_monotonic_ms: ($last_observed_monotonic_ms | try tonumber catch null), ended_at_epoch: ($ended_at_epoch | try tonumber catch null), ended_at_monotonic_ms: ($ended_at_monotonic_ms | try tonumber catch null), elapsed_ms: ($elapsed_ms | try tonumber catch null), state: $state}'
}

wait_result_json() {
  local review_id="$1"
  local artifact_dir="$2"
  local complete="$3"
  local all_tasks_terminal="$4"
  local timed_out="$5"
  local task_result="$6"
  local review_gate="$7"
  local rules_json="$8"
  local timeout_json
  timeout_json="$(wait_diagnostics_json "$artifact_dir")"

  jq -n --arg review_id "$review_id" --arg artifact_dir "$artifact_dir" \
    --argjson complete "$complete" --argjson all_tasks_terminal "$all_tasks_terminal" \
    --argjson timed_out "$timed_out" --arg task_result "$task_result" \
    --arg review_gate "$review_gate" --argjson rules "$rules_json" --argjson timeout "$timeout_json" \
    '{review_id: $review_id, artifact_dir: $artifact_dir, complete: $complete, all_tasks_terminal: $all_tasks_terminal, timed_out: $timed_out, task_result: $task_result, review_gate: $review_gate, timeout: $timeout, rules: $rules}'
}

transition_run_state() {
  local run_directory_path="$1"
  local requested_state="$2"
  local lock_fd
  local current_state

  exec {lock_fd}>"${run_directory_path}/run.lock"
  flock "$lock_fd"
  current_state="$(read_value state "$(run_property_file "$run_directory_path")")"
  if [[ "$current_state" = running ]]; then
    write_value state "$requested_state" "$(run_property_file "$run_directory_path")"
  fi
  flock -u "$lock_fd"
  exec {lock_fd}>&-
  printf '%s\n' "$current_state"
}

finish_wait_diagnostics() {
  local run_directory_path="$1"
  local final_state="$2"
  local wait_file
  local ended_at_epoch
  local ended_at_monotonic_ms=''
  local started_at_epoch
  local started_at_monotonic_ms
  local elapsed_ms=''

  wait_file="$(wait_property_file "$run_directory_path")"
  ended_at_epoch="$(date +%s)"
  ended_at_monotonic_ms="$(monotonic_milliseconds 2>/dev/null || true)"
  started_at_epoch="$(read_value wait_started_at_epoch "$wait_file")"
  started_at_monotonic_ms="$(read_value wait_started_at_monotonic_ms "$wait_file")"

  if [[ "$started_at_monotonic_ms" =~ ^[0-9]+$ && "$ended_at_monotonic_ms" =~ ^[0-9]+$ ]]; then
    elapsed_ms=$((ended_at_monotonic_ms - started_at_monotonic_ms))
  elif [[ "$started_at_epoch" =~ ^[0-9]+$ && "$ended_at_epoch" =~ ^[0-9]+$ ]]; then
    elapsed_ms=$(((ended_at_epoch - started_at_epoch) * 1000))
  fi

  write_value wait_state "$final_state" "$wait_file"
  write_value wait_last_observed_epoch "$ended_at_epoch" "$wait_file"
  write_value wait_last_observed_monotonic_ms "$ended_at_monotonic_ms" "$wait_file"
  write_value wait_ended_at_epoch "$ended_at_epoch" "$wait_file"
  write_value wait_ended_at_monotonic_ms "$ended_at_monotonic_ms" "$wait_file"
  write_value wait_elapsed_ms "$elapsed_ms" "$wait_file"
}

wait_for_run() {
  require_jq
  require_flock
  require_hash_tool
  ensure_store_root

  local review_id=''
  local timeout_seconds="$default_timeout_seconds"
  while (($# > 0)); do
    case "$1" in
      --review-id)
        (($# >= 2)) || die "--review-id needs a value"
        review_id="$2"
        shift 2
        ;;
      --timeout-seconds)
        (($# >= 2)) || die "--timeout-seconds needs a value"
        timeout_seconds="$2"
        shift 2
        ;;
      *)
        die "unknown wait argument: $1"
        ;;
    esac
  done
  [[ -n "$review_id" ]] || die "wait requires --review-id"
  validate_review_id "$review_id"
  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || die "timeout must be a non-negative integer"
  (( timeout_seconds >= minimum_timeout_seconds )) \
    || die "timeout must be at least ${minimum_timeout_seconds} seconds (10 minutes)"

  local run_directory_path
  run_directory_path="$(run_directory "$review_id")"
  local wait_lock_fd
  exec {wait_lock_fd}>"${run_directory_path}/wait.lock"
  if ! flock -n "$wait_lock_fd"; then
    exec {wait_lock_fd}>&-
    die "another wait process is already active for review run: $review_id"
  fi

  local wait_file
  wait_file="$(wait_property_file "$run_directory_path")"
  local run_state
  run_state="$(read_value state "$(run_property_file "$run_directory_path")")"
  local started_at
  local started_at_monotonic_ms=''
  local wait_clock_source
  if [[ "$run_state" = running || ! -f "$wait_file" ]]; then
    started_at="$(date +%s)"
    if started_at_monotonic_ms="$(monotonic_milliseconds 2>/dev/null)"; then
      wait_clock_source=monotonic
    else
      wait_clock_source=wall
    fi
    : > "$wait_file"
    write_value wait_pid "$$" "$wait_file"
    write_value wait_timeout_seconds "$timeout_seconds" "$wait_file"
    write_value wait_clock_source "$wait_clock_source" "$wait_file"
    write_value wait_started_at_epoch "$started_at" "$wait_file"
    write_value wait_started_at_monotonic_ms "$started_at_monotonic_ms" "$wait_file"
    write_value wait_last_observed_epoch "$started_at" "$wait_file"
    write_value wait_last_observed_monotonic_ms "$started_at_monotonic_ms" "$wait_file"
    write_value wait_ended_at_epoch '' "$wait_file"
    write_value wait_ended_at_monotonic_ms '' "$wait_file"
    write_value wait_elapsed_ms 0 "$wait_file"
    write_value wait_state running "$wait_file"
  else
    started_at="$(read_value wait_started_at_epoch "$wait_file")"
    [[ "$started_at" =~ ^[0-9]+$ ]] || started_at="$(date +%s)"
  fi

  local rules_json
  local all_terminal
  local current_time
  local current_monotonic_ms
  local elapsed_ms
  local status_lines
  local status_line
  local rule_id
  local rule_name
  local rule_required
  local rule_state
  local project_root
  local expected_target
  local observed_target
  local required_tasks_complete
  local task_result
  local review_gate_value
  local previous_state

  while :; do
    all_terminal=true
    required_tasks_complete=true
    status_lines="$(mktemp "${run_directory_path}/status.XXXXXX")"
    : > "$status_lines"
    while IFS=$'\t' read -r rule_id rule_name rule_required; do
      [[ -n "$rule_id" ]] || continue
      status_line="$(status_json "$run_directory_path" "$rule_id" "$rule_name" "$rule_required")"
      printf '%s\n' "$status_line" >> "$status_lines"
      rule_state="$(jq -r '.state' <<< "$status_line")"
      case "$rule_state" in
        completed|failed|blocked) ;;
        *) all_terminal=false ;;
      esac
      if [[ "$rule_required" = true && "$rule_state" != completed ]]; then
        required_tasks_complete=false
      fi
    done < "$(rules_file "$run_directory_path")"
    rules_json="$(jq -s '.' "$status_lines")"
    rm -f -- "$status_lines"

    run_state="$(read_value state "$(run_property_file "$run_directory_path")")"
    if [[ "$run_state" = timed_out ]]; then
      wait_result_json "$review_id" "$run_directory_path" false false true \
        timed-out blocked "$rules_json"
      return 2
    fi
    if [[ "$run_state" = invalidated ]]; then
      wait_result_json "$review_id" "$run_directory_path" false false false \
        source-changed blocked "$rules_json"
      return 3
    fi

    project_root="$(read_value project_root "$(run_property_file "$run_directory_path")")"
    expected_target="$(read_value target "$(run_property_file "$run_directory_path")")"
    observed_target="$(target_commit "$project_root")"
    if [[ "$expected_target" != "$observed_target" ]]; then
      previous_state="$(transition_run_state "$run_directory_path" invalidated)"
      if [[ "$previous_state" = running ]]; then
        finish_wait_diagnostics "$run_directory_path" invalidated
        wait_result_json "$review_id" "$run_directory_path" false false false \
          source-changed blocked "$rules_json"
        return 3
      fi
      continue
    fi

    if [[ "$all_terminal" = true ]]; then
      previous_state="$(transition_run_state "$run_directory_path" complete)"
      if [[ "$previous_state" = timed_out ]]; then
        wait_result_json "$review_id" "$run_directory_path" false false true \
          timed-out blocked "$rules_json"
        return 2
      fi
      if [[ "$previous_state" = invalidated ]]; then
        wait_result_json "$review_id" "$run_directory_path" false false false \
          source-changed blocked "$rules_json"
        return 3
      fi
      if [[ "$previous_state" = running ]]; then
        finish_wait_diagnostics "$run_directory_path" completed
      fi
      if [[ "$required_tasks_complete" = true ]]; then
        task_result=ready-for-aggregation
        review_gate_value=requires-report-aggregation
      else
        task_result=required-task-failed
        review_gate_value=blocked
      fi
      wait_result_json "$review_id" "$run_directory_path" true true false \
        "$task_result" "$review_gate_value" "$rules_json"
      return 0
    fi

    current_time="$(date +%s)"
    current_monotonic_ms="$(monotonic_milliseconds 2>/dev/null || true)"
    started_at_monotonic_ms="$(read_value wait_started_at_monotonic_ms "$wait_file")"
    if [[ "$started_at_monotonic_ms" =~ ^[0-9]+$ && "$current_monotonic_ms" =~ ^[0-9]+$ ]]; then
      elapsed_ms=$((current_monotonic_ms - started_at_monotonic_ms))
    else
      elapsed_ms=$(((current_time - started_at) * 1000))
    fi
    if ((elapsed_ms >= timeout_seconds * 1000)); then
      previous_state="$(transition_run_state "$run_directory_path" timed_out)"
      if [[ "$previous_state" = running ]]; then
        finish_wait_diagnostics "$run_directory_path" timed_out
        wait_result_json "$review_id" "$run_directory_path" false false true \
          timed-out blocked "$rules_json"
        return 2
      fi
      continue
    fi
    sleep 1
  done
}

cleanup_run() {
  require_jq
  ensure_store_root

  local review_id=''
  local after_aggregation=false
  while (($# > 0)); do
    case "$1" in
      --review-id)
        (($# >= 2)) || die "--review-id needs a value"
        review_id="$2"
        shift 2
        ;;
      --after-aggregation)
        after_aggregation=true
        shift
        ;;
      *)
        die "unknown cleanup argument: $1"
        ;;
    esac
  done
  [[ -n "$review_id" ]] || die "cleanup requires --review-id"
  validate_review_id "$review_id"

  local run_directory_path
  run_directory_path="$(run_directory "$review_id")"
  local run_state
  run_state="$(read_value state "$(run_property_file "$run_directory_path")")"
  [[ "$run_state" != running ]] || die "cannot clean up an active review run: $review_id"
  if [[ "$run_state" = timed_out || "$run_state" = invalidated ]]; then
    [[ "$after_aggregation" = true ]] \
      || die "cannot clean up a ${run_state} review run before report aggregation; use --after-aggregation after reading reports"
    local rule_id
    local rule_name
    local rule_required
    local task_properties_file
    local task_state
    while IFS=$'\t' read -r rule_id rule_name rule_required; do
      [[ -n "$rule_id" ]] || continue
      task_properties_file="$(task_file_for_rule "$run_directory_path" "$rule_id")"
      [[ -n "$task_properties_file" ]] || die "cannot clean up ${run_state} review run before every task is terminal: missing task $rule_id"
      task_state="$(read_value state "$task_properties_file")"
      case "$task_state" in
        completed|failed|blocked) ;;
        *) die "cannot clean up ${run_state} review run before every task is terminal: $rule_id ($task_state)" ;;
      esac
    done < "$(rules_file "$run_directory_path")"
  fi
  run_directory_path="$(run_directory "$review_id")"
  rm -rf -- "$run_directory_path"
  jq -n --arg review_id "$review_id" --arg state "$run_state" \
    '{review_id: $review_id, cleaned: true, previous_state: $state}'
}

usage() {
  cat <<'EOF'
Usage:
  workflow-review start --project-root <path> [--rule-id <id>]...
  workflow-review get-task --review-id <review-id> --rule-id <id>
  workflow-review start-step --task-id <task-id> --step-id <id>
  workflow-review add-step --task-id <task-id> --parent-step-id <id> --step-id <id> --reason <text>
  workflow-review complete-step --task-id <task-id> --step-id <id> [--status completed|failed|blocked] [--reason <text>]
  workflow-review submit --task-id <task-id> [--status completed|failed|blocked]
  workflow-review status --review-id <review-id>
  workflow-review wait --review-id <review-id> [--timeout-seconds <seconds; minimum 600>]
  workflow-review cleanup --review-id <review-id> [--after-aggregation]
EOF
}

main() {
  (($# > 0)) || { usage; exit 2; }
  local subcommand="$1"
  shift
  case "$subcommand" in
    start) start_run "$@" ;;
    get-task) get_task "$@" ;;
    start-step) start_step "$@" ;;
    add-step) add_step "$@" ;;
    complete-step) complete_step "$@" ;;
    submit) submit_task "$@" ;;
    status) review_status "$@" ;;
    wait) wait_for_run "$@" ;;
    cleanup) cleanup_run "$@" ;;
    help|--help|-h) usage ;;
    *) die "unknown command: $subcommand" ;;
  esac
}

main "$@"
